---
import { profile } from '../data/content.js';

const sections = [
  { id: 'about', label: 'About' },
  { id: 'skills', label: 'Skills' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'hobbies', label: 'Hobbies' },
  { id: 'contact', label: 'Contact' },
];
---

<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a href="#top" class="mark" aria-label={`${profile.name}, back to top`}>
<!-- Logo: "ME" in looping strands of yarn. The E is the M turned on its side. -->
      <svg class="mark-logo" viewBox="0 0 53 32" fill="none" aria-hidden="true">
        <path class="mark-line" pathLength="1" d="M5 25 L5 14 C5 9 8 7 11 7 C15 7 18.5 11 18.5 17 C18.5 22 13.5 22 13.5 17 C13.5 11 17 7 21 7 C24 7 27 9 27 14 L27 25" />
        <path class="mark-line mark-line-e" pathLength="1" d="M47.7 25 L38.7 25 C34.6 25 33 22.5 33 20.1 C33 16.8 36.3 14 41.2 14 C45.3 14 45.3 18 41.2 18 C36.3 18 33 15.2 33 11.9 C33 9.5 34.6 7 38.7 7 L47.7 7" />
        <circle class="mark-end" cx="5" cy="25" r="2" />
        <circle class="mark-end" cx="27" cy="25" r="2" />
        <circle class="mark-end" cx="47.7" cy="7.0" r="2" />
        <circle class="mark-end" cx="47.7" cy="25.0" r="2" />
      </svg>
      <span class="mark-name">{profile.name}</span>
    </a>

    <nav aria-label="Sections">
      <ul class="links" data-links>
        {sections.map((s) => (
          <li>
            <a href={`#${s.id}`} data-link={s.id}>{s.label}</a>
          </li>
        ))}
        <!-- Slides under whichever section is in view -->
        <li class="indicator" data-indicator aria-hidden="true"></li>
      </ul>
    </nav>

    <div class="nav-end">
      <button class="cmd" type="button" data-palette-open aria-label="Open command menu">
        <span>Menu</span>
        <kbd data-shortcut>⌘K</kbd>
      </button>

      <button class="burger" type="button" data-burger aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">Menu</span>
        <span class="burger-box" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="drawer" id="mobile-menu" data-drawer hidden>
    <ul>
      {sections.map((s) => (
        <li><a href={`#${s.id}`} data-close>{s.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<script>
  // ── Highlight the section currently in view ────────────────
  const links = document.querySelectorAll('[data-link]');
  const indicator = document.querySelector('[data-indicator]');
  const ids = [...links].map((a) => a.dataset.link);
  const targets = ids
    .map((id) => document.getElementById(id))
    .filter((el) => el !== null);
  let activeId = null;

  // Slide the indicator to sit under the active link
  function placeIndicator() {
    if (!indicator) return;
    const link = [...links].find((a) => a.dataset.link === activeId);
    if (!link) {
      indicator.style.opacity = '0';
      return;
    }
    indicator.style.opacity = '1';
    indicator.style.width = `${link.offsetWidth}px`;
    indicator.style.transform = `translateX(${link.offsetLeft}px)`;
  }

  function setActive(id) {
    activeId = id;
    links.forEach((a) => {
      const on = a.dataset.link === id;
      a.classList.toggle('is-active', on);
      if (on) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
    placeIndicator();
  }

  if (targets.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        // Of everything currently visible, pick the entry nearest the top
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      // Band across the upper-middle of the viewport
      { rootMargin: '-22% 0px -58% 0px', threshold: 0 }
    );
    targets.forEach((el) => spy.observe(el));
  }

  // Link widths change with the viewport, the font, and the design
  window.addEventListener('resize', placeIndicator);
  document.fonts?.ready.then(placeIndicator);
  document.addEventListener('design:change', () => setTimeout(placeIndicator, 350));

  // ── Shortcut hint: ⌘K on Apple devices, Ctrl K elsewhere ───
  const hint = document.querySelector('[data-shortcut]');
  if (hint && !/Mac|iPhone|iPad/.test(navigator.platform)) hint.textContent = 'Ctrl K';

  // ── Mobile drawer ──────────────────────────────────────────
  const burger = document.querySelector('[data-burger]');
  const drawer = document.querySelector('[data-drawer]');

  function closeDrawer() {
    if (!burger || !drawer) return;
    burger.setAttribute('aria-expanded', 'false');
    drawer.hidden = true;
    document.body.style.overflow = '';
  }

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    if (open) {
      closeDrawer();
    } else {
      burger.setAttribute('aria-expanded', 'true');
      drawer.hidden = false;
      document.body.style.overflow = 'hidden';
    }
  });

  drawer?.querySelectorAll('[data-close]').forEach((a) => {
    a.addEventListener('click', closeDrawer);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });

  // Reset the drawer if the viewport grows past the mobile breakpoint
  window.matchMedia('(min-width: 821px)').addEventListener('change', (e) => {
    if (e.matches) closeDrawer();
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }
  /* Frosts over once the page has scrolled */
  .nav.is-stuck {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border-bottom-color: var(--line);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    flex-shrink: 0;
  }
  .mark-logo {
    width: 3.75rem;
    height: 2.25rem;
    overflow: visible;
  }
  .mark-line {
    stroke: var(--accent);
    stroke-width: 2.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  /* The two loose ends of the strand */
  .mark-end {
    fill: var(--text);
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transition: transform 0.5s var(--spring);
  }
  /* On hover each strand is pulled through again, the M and then the E */
  .mark:hover .mark-line { animation: trace 0.9s var(--ease-in-out) both; }
  .mark:hover .mark-line-e { animation-delay: 0.45s; }
  .mark:hover .mark-end { transform: scale(1.25); }
  @keyframes trace {
    from { stroke-dashoffset: 1; }
    to   { stroke-dashoffset: 0; }
  }
  .mark-name { font-size: 0.97rem; }

  .links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }
  .links a {
    display: block;
    padding: 0.5rem 0.8rem;
    font-size: 0.91rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.3s var(--ease);
  }
  .links a:hover,
  .links a.is-active { color: var(--text); }

  .indicator {
    position: absolute;
    left: 0;
    bottom: 0.1rem;
    height: 2px;
    width: 0;
    background: var(--accent);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.55s var(--ease), width 0.55s var(--ease), opacity 0.3s var(--ease);
  }
  /* Afterglow swaps the underline for a soft pill behind the label */
  :global(html[data-theme='afterglow']) .indicator {
    top: 50%;
    bottom: auto;
    height: 2.1rem;
    margin-top: -1.05rem;
    border-radius: 999px;
    background: var(--accent-soft);
    z-index: -1;
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .cmd {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.38rem 0.45rem 0.38rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--btn-radius);
    background: var(--surface);
    font-size: 0.84rem;
    color: var(--muted);
    cursor: pointer;
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease), scale 0.2s var(--ease);
  }
  .cmd:hover { border-color: var(--line-2); color: var(--text); }
  .cmd:active { scale: 0.97; }
  .cmd kbd {
    padding: 0.1rem 0.4rem;
    border-radius: calc(var(--btn-radius) / 2 + 2px);
    background: var(--surface-2);
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
  }

  .burger {
    display: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.58rem;
    cursor: pointer;
    color: var(--text);
  }
  .burger-box {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .burger-box i {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .burger[aria-expanded='true'] .burger-box i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger-box i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .drawer {
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    padding: 0.5rem var(--gutter) 1.25rem;
  }
  .drawer a {
    display: block;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--display);
    font-size: 1.3rem;
    font-weight: var(--display-weight);
    color: var(--text);
  }
  .drawer li:last-child a { border-bottom: 0; }

  @media (max-width: 820px) {
    .links, .cmd { display: none; }
    .burger { display: block; }
    .mark-name { display: none; }
  }
</style>
