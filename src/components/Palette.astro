---
import { profile, site } from '../data/content.js';

// `preview` adds the design-switching commands (dev only)
const { preview = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const resumeHref = `${base}/${profile.resume}`.replace(/\/+/g, '/');

const commands = [
  ...['About', 'Skills', 'Experience', 'Projects', 'Hobbies', 'Contact'].map((label) => ({
    group: 'Go to', label, action: 'goto', value: `#${label.toLowerCase()}`,
  })),
  { group: 'Action', label: 'Copy email address', action: 'copy', value: profile.email },
  { group: 'Action', label: 'Write an email', action: 'open', value: `mailto:${profile.email}` },
  { group: 'Action', label: 'Download résumé', action: 'download', value: resumeHref },
  { group: 'Link', label: 'Open LinkedIn', action: 'tab', value: profile.links.linkedin },
  { group: 'Link', label: 'Open GitHub', action: 'tab', value: profile.links.github },
  ...(preview
    ? site.designs.map((d) => ({
        group: 'Design', label: `Switch to ${d.name}`, action: 'design', value: d.id,
      }))
    : []),
];
---

<dialog class="palette" data-palette aria-label="Command menu" data-home={base}>
  <div class="box">
    <input
      class="field"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      aria-label="Search commands"
      placeholder="Jump to a section or run a command"
      autocomplete="off"
      spellcheck="false"
      data-palette-input
    />

    <ul class="list" id="palette-list" role="listbox" aria-label="Commands" data-palette-list>
      {commands.map((c, i) => (
        <li
          class="cmd"
          role="option"
          id={`cmd-${i}`}
          aria-selected="false"
          data-action={c.action}
          data-value={c.value}
          data-search={`${c.label} ${c.group}`.toLowerCase()}
        >
          <span>{c.label}</span>
          <span class="cmd-group">{c.group}</span>
        </li>
      ))}
    </ul>
    <p class="empty" data-palette-empty hidden>No command matches that.</p>

    <p class="keys" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> run</span>
      <span><kbd>esc</kbd> close</span>
    </p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector('[data-palette]');
  const input = document.querySelector('[data-palette-input]');
  const empty = document.querySelector('[data-palette-empty]');
  const items = [...document.querySelectorAll('[data-palette-list] [role="option"]')];
  let active = 0;

  const shown = () => items.filter((el) => !el.hidden);

  function highlight(index) {
    const list = shown();
    active = list.length ? (index + list.length) % list.length : 0;
    items.forEach((el) => el.setAttribute('aria-selected', 'false'));
    const el = list[active];
    if (el) {
      el.setAttribute('aria-selected', 'true');
      el.scrollIntoView({ block: 'nearest' });
      input.setAttribute('aria-activedescendant', el.id);
    } else {
      input.removeAttribute('aria-activedescendant');
    }
  }

  function filter() {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    items.forEach((el) => {
      el.hidden = !words.every((w) => el.dataset.search.includes(w));
    });
    empty.hidden = shown().length > 0;
    highlight(0);
  }

  function open() {
    if (dialog.open) return;
    input.value = '';
    filter();
    dialog.showModal();
  }

  function run(el) {
    const { action, value } = el.dataset;
    dialog.close();

    if (action === 'goto') {
      const target = document.querySelector(value);
      // On pages without that section (the 404), go to it on the home page
      if (target) target.scrollIntoView();
      else location.href = `${dialog.dataset.home.replace(/\/$/, '')}/${value}`;
    } else if (action === 'copy') {
      navigator.clipboard.writeText(value).then(
        () => document.dispatchEvent(new CustomEvent('toast', { detail: 'Email copied to clipboard' })),
        () => document.dispatchEvent(new CustomEvent('toast', { detail: 'Copy failed. The address is in Contact.' }))
      );
    } else if (action === 'open') {
      location.href = value;
    } else if (action === 'tab') {
      window.open(value, '_blank', 'noopener');
    } else if (action === 'download') {
      const a = document.createElement('a');
      a.href = value;
      a.download = '';
      a.click();
    } else if (action === 'design') {
      document.dispatchEvent(new CustomEvent('design:set', { detail: value }));
    }
  }

  if (dialog && input) {
    document.querySelectorAll('[data-palette-open]').forEach((btn) => {
      btn.addEventListener('click', open);
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });

    input.addEventListener('input', filter);

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); highlight(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(active - 1); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        const el = shown()[active];
        if (el) run(el);
      }
    });

    items.forEach((el) => {
      el.addEventListener('click', () => run(el));
      el.addEventListener('pointermove', () => {
        if (el.getAttribute('aria-selected') !== 'true') highlight(shown().indexOf(el));
      });
    });

    // A click on the dimmed backdrop lands on the dialog element itself
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .palette {
    width: min(34rem, calc(100vw - 2rem));
    max-height: min(30rem, calc(100dvh - 6rem));
    margin: 14vh auto auto;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: max(var(--radius-sm), 8px);
    background: var(--bg-2);
    color: var(--text);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  .palette[open] { animation: pop 0.32s var(--spring); }
  .palette::backdrop {
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: fade 0.25s var(--ease);
  }
  @keyframes pop {
    from { opacity: 0; transform: translateY(-0.6rem) scale(0.97); }
  }
  @keyframes fade {
    from { opacity: 0; }
  }

  .box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .field {
    width: 100%;
    padding: 1.05rem 1.2rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
  }
  .field::placeholder { color: var(--faint); }
  /* The whole dialog is the focus container; the selected row shows position */
  .field:focus-visible { outline: none; }

  .list {
    overflow-y: auto;
    padding: 0.4rem;
  }
  .cmd {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.62rem 0.8rem;
    border-radius: max(calc(var(--radius-sm) - 2px), 4px);
    font-size: 0.94rem;
    cursor: pointer;
  }
  /* `display: flex` above would otherwise override the hidden attribute */
  .cmd[hidden] { display: none; }
  .cmd[aria-selected='true'] {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .cmd-group {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
  }

  .empty {
    padding: 1.4rem 1.2rem;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .keys {
    display: flex;
    gap: 1.2rem;
    padding: 0.65rem 1.2rem;
    border-top: 1px solid var(--line);
    font-size: 0.74rem;
    color: var(--faint);
  }
  .keys kbd {
    margin-right: 0.25rem;
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    background: var(--surface-2);
    font-family: var(--mono);
    font-size: 0.7rem;
  }
</style>
