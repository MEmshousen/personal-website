---
import { about } from '../data/content.js';
---

<section class="section" id="about">
  <div class="wrap">
    <div class="grid">
      <div class="copy">
        <p class="eyebrow" data-reveal><span class="eyebrow-num">01</span>{about.heading}</p>
        <h2 class="section-title" data-reveal style="--reveal-delay: 60ms">
          Engineering, <em class="em">applied to security.</em>
        </h2>

        <div class="prose">
          {about.paragraphs.map((p, i) => (
            <p data-reveal style={`--reveal-delay: ${120 + i * 90}ms`}>{p}</p>
          ))}
        </div>
      </div>

      <ul class="stats">
        {about.stats.map((s, i) => (
          <li class="stat" data-reveal style={`--reveal-delay: ${i * 110}ms`}>
            <span class="stat-value">
              <span class="affix">{s.prefix ?? ''}</span>
              <span
                class="num"
                data-count={s.value}
                data-suffix={s.suffix ?? ''}
              >0</span>
            </span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // ── Count each stat up the first time it scrolls into view ──
  const nums = document.querySelectorAll('[data-count]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function render(el, value) {
    el.textContent = `${value}${el.dataset.suffix || ''}`;
  }

  if (reduced) {
    nums.forEach((el) => render(el, Number(el.dataset.count)));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target;
          io.unobserve(el);

          const target = Number(el.dataset.count);
          const duration = 1500;
          const start = performance.now();

          function step(now) {
            const t = Math.min((now - start) / duration, 1);
            // easeOutExpo — fast at first, settles gently on the number
            const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
            render(el, Math.round(target * eased));
            if (t < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.45 }
    );
    nums.forEach((el) => io.observe(el));
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .prose {
    display: grid;
    gap: 1.2rem;
    margin-top: 1.8rem;
    color: var(--muted);
    font-size: 1.04rem;
    max-width: 62ch;
  }
  /* The opening paragraph reads as a lede */
  .prose p:first-child {
    color: var(--text);
    font-size: 1.14rem;
    line-height: 1.6;
  }

  /* Figures set as a ruled ledger rather than four boxes */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.75rem;
    position: sticky;
    top: 6.5rem;
  }

  .stat {
    position: relative;
    padding: 1.3rem 0 1.5rem;
    border-top: 1px solid var(--line-2);
  }
  /* Accent rule that draws across the top on hover */
  .stat::before {
    content: '';
    position: absolute;
    top: -1px; left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.6s var(--ease);
  }
  .stat:hover::before { transform: scaleX(1); }

  .stat-value {
    display: flex;
    align-items: baseline;
    font-family: var(--display);
    font-size: calc(clamp(2rem, 4.4vw, 2.9rem) * var(--title-scale));
    font-weight: var(--display-weight);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    letter-spacing: var(--display-tracking);
    line-height: 1;
    /* Reserve height so the layout doesn't shift as digits appear */
    min-height: 1em;
  }
  .affix { color: var(--accent); }

  .stat-label {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .stats { position: static; }
  }
</style>
