---
import { contact, profile } from '../data/content.js';

const resumeHref = `${import.meta.env.BASE_URL}/${profile.resume}`.replace(/\/+/g, '/');

const channels = [
  { label: 'LinkedIn', value: 'madison-emshousen', href: profile.links.linkedin },
  { label: 'GitHub', value: 'MEmshousen', href: profile.links.github },
  { label: 'Résumé', value: 'PDF download', href: resumeHref, download: true },
];
---

<section class="section contact" id="contact">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="eyebrow-num">06</span>{contact.heading}</p>
    <h2 class="contact-title" data-reveal style="--reveal-delay: 60ms">
      Got something <em class="em">interesting?</em>
    </h2>

    <div class="grid">
      <div class="lead" data-reveal style="--reveal-delay: 120ms">
        <p class="blurb">{contact.blurb}</p>

        <!-- The address itself is the main action -->
        <a class="email" href={`mailto:${profile.email}`}>
          <span class="email-text">{profile.email}</span>
          <svg viewBox="0 0 16 16" width="0.7em" height="0.7em" fill="none" aria-hidden="true">
            <path d="M4 12 12 4M12 4H6M12 4v6" stroke="currentColor" stroke-width="1.3"
                  stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <div class="actions">
          <a class="btn" href={`mailto:${profile.email}`} data-magnetic>Write to me</a>
          <button class="link" type="button" data-copy={profile.email}>Copy address</button>
        </div>
      </div>

      <ul class="channels" data-reveal style="--reveal-delay: 200ms">
        {channels.map((c) => (
          <li>
            <a
              class="channel"
              href={c.href}
              download={c.download}
              target={c.download ? undefined : '_blank'}
              rel={c.download ? undefined : 'noopener noreferrer'}
            >
              <span class="channel-label">{c.label}</span>
              <span class="channel-value">{c.value}</span>
              <svg class="channel-arrow" viewBox="0 0 14 14" width="13" height="13"
                   fill="none" aria-hidden="true">
                <path d="M4 10 10 4M10 4H5.5M10 4v4.5" stroke="currentColor"
                      stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-title {
    font-size: calc(clamp(2.4rem, 7.4vw, 5rem) * var(--title-scale));
    line-height: 1;
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: end;
  }

  .blurb {
    color: var(--muted);
    max-width: 46ch;
    font-size: 1.06rem;
    margin-bottom: 1.6rem;
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    margin-bottom: 2rem;
    font-family: var(--display);
    font-size: calc(clamp(1.25rem, 3.6vw, 2.1rem) * var(--title-scale));
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    line-height: 1.2;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0% 2px no-repeat;
    transition: background-size 0.6s var(--ease), color 0.3s var(--ease);
  }
  .email-text { overflow-wrap: anywhere; }
  .email:hover { background-size: 100% 2px; color: var(--accent); }
  .email svg { flex-shrink: 0; transition: transform 0.4s var(--spring); }
  .email:hover svg { transform: translate(3px, -3px); }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
  }

  /* ── Other ways to reach me, as ruled rows ──────────────── */
  .channel {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0.25rem;
    border-top: 1px solid var(--line);
    transition: padding 0.45s var(--ease), border-color 0.35s var(--ease);
  }
  .channels li:last-child .channel { border-bottom: 1px solid var(--line); }
  .channel:hover {
    padding-left: 0.85rem;
    border-top-color: var(--accent);
  }
  .channel:active { scale: 0.99; }

  .channel-label {
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--faint);
  }
  .channel-value {
    font-size: 1rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .channel-arrow {
    align-self: center;
    color: var(--faint);
    transition: color 0.3s var(--ease), transform 0.4s var(--spring);
  }
  .channel:hover .channel-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
