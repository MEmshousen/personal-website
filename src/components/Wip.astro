---
import { wip } from '../data/content.js';

const imageHref = wip.image
  ? `${import.meta.env.BASE_URL}/${wip.image}`.replace(/\/+/g, '/')
  : null;

// Five cards, because a hand in the game is five. --a is each card's angle.
const fan = [-24, -12, 0, 12, 24];
---

<section class="section" id="wip">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="eyebrow-num">04</span>{wip.heading}</p>
    <h2 class="section-title" data-reveal style="--reveal-delay: 60ms">
      On the <em class="em">table now.</em>
    </h2>

    <article class="card build" data-reveal style="--reveal-delay: 140ms">
      <!-- A fanned hand of cards that spreads on hover -->
      <div class="stage" aria-hidden="true">
        <div class="fan">
          {fan.map((angle, i) => (
            <span class={`playing-card ${i === 2 ? 'is-face' : ''}`} style={`--a: ${angle}deg; --i: ${i}`}>
              {i === 2 && imageHref && <img src={imageHref} alt="" width="256" height="256" loading="lazy" />}
            </span>
          ))}
        </div>
      </div>

      <div class="body">
        <p class="status"><span class="dot" aria-hidden="true"></span>{wip.status}</p>
        <h3 class="title">{wip.title}</h3>
        <p class="summary">{wip.summary}</p>
        <p class="role">{wip.role}</p>

        <footer class="foot">
          <ul class="stack">
            {wip.stack.map((s) => <li>{s}</li>)}
          </ul>
          <p class="meta">{wip.meta}</p>
          {wip.links?.length > 0 && (
            <div class="links">
              {wip.links.map((l) => (
                <a class="link" href={l.url} target="_blank" rel="noopener noreferrer">
                  {l.label}
                  <svg viewBox="0 0 14 14" width="12" height="12" fill="none" aria-hidden="true">
                    <path d="M4 10 10 4M10 4H5.5M10 4v4.5" stroke="currentColor"
                          stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              ))}
            </div>
          )}
        </footer>
      </div>
    </article>
  </div>
</section>

<style>
  .build {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: center;
    margin-top: 2.5rem;
    padding: clamp(1.6rem, 4vw, 2.6rem) max(var(--card-pad-x), 0rem);
    overflow: hidden;
  }

  /* ── The hand of cards ──────────────────────────────────── */
  .stage {
    display: grid;
    place-items: center;
    min-height: 15rem;
  }
  .fan {
    position: relative;
    width: 7.5rem;
    height: 10.5rem;
  }
  .playing-card {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 0.7rem;
    border: 1px solid var(--line-2);
    /* Card back: a fine diagonal weave in the accent colour */
    background:
      repeating-linear-gradient(45deg, var(--accent-soft) 0 2px, transparent 2px 8px),
      repeating-linear-gradient(-45deg, var(--accent-soft) 0 2px, transparent 2px 8px),
      var(--bg-2);
    box-shadow: 0 10px 24px -14px rgba(0, 0, 0, 0.7);
    transform-origin: 50% 130%;
    transform: rotate(calc(var(--a) * 0.55));
    transition: transform 0.7s var(--spring);
    transition-delay: calc(var(--i) * 30ms);
  }
  /* The middle card is face up and shows the game's icon */
  .playing-card.is-face {
    z-index: 1;
    background: #f1e7d6;
    border-color: var(--accent);
  }
  .playing-card img { width: 78%; height: auto; }

  /* On hover the hand fans out and the face card lifts */
  .build:hover .playing-card { transform: rotate(var(--a)); }
  .build:hover .playing-card.is-face { transform: translateY(-0.9rem) scale(1.04); }

  /* ── Details ────────────────────────────────────────────── */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
    font-family: var(--mono);
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--accent);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: wip-pulse 1.8s var(--ease-in-out) infinite alternate;
  }
  @keyframes wip-pulse {
    from { opacity: 0.35; transform: scale(0.8); }
    to   { opacity: 1; transform: scale(1); }
  }

  .title {
    font-size: calc(clamp(2rem, 4.6vw, 2.9rem) * var(--title-scale));
    margin-bottom: 0.9rem;
  }
  .summary {
    max-width: 56ch;
    font-size: 1.06rem;
    color: var(--text);
    margin-bottom: 0.9rem;
  }
  .role {
    max-width: 56ch;
    color: var(--muted);
  }

  .foot {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.4rem;
  }
  .stack li {
    padding: 0.2rem 0.6rem;
    border-radius: calc(var(--radius-sm) / 2 + 2px);
    background: var(--surface-2);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
  }
  .meta {
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--faint);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  @media (max-width: 760px) {
    .build { grid-template-columns: 1fr; }
    .stage { min-height: 13rem; }
  }
</style>
