---
import { skills } from '../data/content.js';

const pad = (n) => String(n).padStart(2, '0');
---

<section class="section" id="skills">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="eyebrow-num">02</span>{skills.heading}</p>
    <h2 class="section-title" data-reveal style="--reveal-delay: 60ms">
      The <em class="em">toolkit.</em>
    </h2>
    <p class="section-blurb" data-reveal style="--reveal-delay: 120ms">
      Grouped by what I actually reach for: security work up front, the engineering
      underneath it after.
    </p>

    <!-- Index on the left, the selected group's skills on the right.
         Without JavaScript every group simply renders in a column. -->
    <div class="index" data-tabs data-reveal style="--reveal-delay: 180ms">
      <div class="tabs" role="tablist" aria-label="Skill groups">
        {skills.groups.map((group, gi) => (
          <button
            class={`tab ${gi === 0 ? 'is-active' : ''}`}
            type="button"
            role="tab"
            id={`skill-tab-${gi}`}
            aria-controls={`skill-panel-${gi}`}
            aria-selected={gi === 0 ? 'true' : 'false'}
            tabindex={gi === 0 ? 0 : -1}
          >
            <span class="tab-num">{pad(gi + 1)}</span>
            <span class="tab-name">{group.name}</span>
            <span class="tab-count">{group.items.length}</span>
          </button>
        ))}
      </div>

      <div class="panels">
        {skills.groups.map((group, gi) => (
          <div
            class={`panel ${gi === 0 ? 'is-active' : ''}`}
            role="tabpanel"
            id={`skill-panel-${gi}`}
            aria-labelledby={`skill-tab-${gi}`}
          >
            <h3 class="panel-title">{group.name}</h3>
            <ul class="chips">
              {group.items.map((item, ii) => (
                <li class="chip" style={`--i: ${ii}`}>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {skills.certifications.length > 0 && (
      <div class="certs" data-reveal>
        <h3 class="certs-title">Certifications</h3>
        <ul class="cert-list">
          {skills.certifications.map((c) => (
            <li class="card cert">
              <span class="cert-name">
                {c.url
                  ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                  : c.name}
              </span>
              <span class="cert-meta">{c.issuer}{c.year ? ` · ${c.year}` : ''}</span>
              {c.status && <span class="cert-status">{c.status}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<script>
  // ── Tabs: hover, click, or arrow keys switch the visible group ──
  const tabs = [...document.querySelectorAll('[data-tabs] [role="tab"]')];
  const panels = [...document.querySelectorAll('[data-tabs] [role="tabpanel"]')];
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  function select(index, focus = false) {
    tabs.forEach((tab, i) => {
      const on = i === index;
      tab.classList.toggle('is-active', on);
      tab.setAttribute('aria-selected', on ? 'true' : 'false');
      tab.tabIndex = on ? 0 : -1;
      panels[i]?.classList.toggle('is-active', on);
    });
    if (focus) tabs[index].focus();
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(i));
    if (fine) tab.addEventListener('pointerenter', () => select(i));

    tab.addEventListener('keydown', (e) => {
      const last = tabs.length - 1;
      let next = null;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = last;
      if (next === null) return;
      e.preventDefault();
      select(next, true);
    });
  });
</script>

<style>
  .index {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 5rem);
    margin-top: 3.25rem;
    align-items: start;
  }

  /* ── Left: the index of groups ──────────────────────────── */
  .tabs { display: grid; }
  .tab {
    position: relative;
    display: grid;
    grid-template-columns: 2.4rem 1fr auto;
    align-items: baseline;
    gap: 0.5rem;
    padding: 1rem 0.25rem;
    border: 0;
    border-top: 1px solid var(--line);
    background: none;
    text-align: left;
    color: var(--faint);
    cursor: pointer;
    transition: color 0.35s var(--ease), padding 0.45s var(--ease);
  }
  .tab:last-child { border-bottom: 1px solid var(--line); }
  .tab-num,
  .tab-count {
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .tab-name {
    font-family: var(--display);
    font-size: calc(clamp(1.15rem, 2.3vw, 1.5rem) * var(--title-scale));
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    line-height: 1.15;
  }
  .tab:hover { color: var(--muted); }
  .tab.is-active {
    color: var(--text);
    padding-left: 0.9rem;
  }
  .tab.is-active .tab-num { color: var(--accent); }
  /* Accent tick marking the open group */
  .tab::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 2px;
    height: 1.4rem;
    margin-top: -0.7rem;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.45s var(--ease);
  }
  .tab.is-active::before { transform: scaleY(1); }

  /* ── Right: the skills in the open group ────────────────── */
  /* Panels share one grid cell, so the box never changes height */
  :global(.js) .panels { display: grid; }
  :global(.js) .panel {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s var(--ease), visibility 0s 0.3s;
  }
  :global(.js) .panel.is-active {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }
  .panel { margin-bottom: 2rem; }
  :global(.js) .panel { margin-bottom: 0; }

  .panel-title {
    font-size: 1.1rem;
    margin-bottom: 0.9rem;
  }
  /* With tabs running, the tab itself is the panel's label */
  :global(.js) .panel-title {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .chip {
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease),
                color 0.3s var(--ease), transform 0.4s var(--spring);
  }
  .chip:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }
  /* Each skill rises in, one after another, when its group opens */
  :global(.js) .panel.is-active .chip {
    animation: chip-in 0.55s var(--ease) backwards;
    animation-delay: calc(var(--i) * 45ms);
  }
  @keyframes chip-in {
    from { opacity: 0; transform: translateY(0.7rem); }
  }

  /* Dossier: skills are set as a run of large serif text, no boxes */
  :global(html[data-theme='dossier']) .chips { gap: 0.2rem 0; }
  :global(html[data-theme='dossier']) .chip {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--display);
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    font-weight: 400;
    line-height: 1.2;
  }
  :global(html[data-theme='dossier']) .chip:not(:last-child)::after {
    content: '/';
    margin-inline: 0.45em;
    color: var(--line-2);
  }
  :global(html[data-theme='dossier']) .chip:hover {
    background: none;
    color: var(--accent);
    font-style: italic;
    transform: none;
  }

  /* Signal: monospace tags */
  :global(html[data-theme='signal']) .chip {
    font-family: var(--mono);
    font-size: 0.86rem;
    font-weight: 400;
  }

  /* ── Certifications (hidden until the array has entries) ─── */
  .certs { margin-top: 3.5rem; }
  .certs-title {
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }
  .cert-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 0.75rem;
  }
  .cert {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 1rem;
    padding: 1rem var(--card-pad-x);
  }
  .cert-name, .cert-meta { grid-column: 1; }
  /* "In progress" marker, with a dot that pulses */
  .cert-status {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
  }
  .cert-status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: cert-pulse 1.8s var(--ease-in-out) infinite alternate;
  }
  @keyframes cert-pulse {
    from { opacity: 0.35; }
    to   { opacity: 1; }
  }
  .cert-name { display: block; font-weight: 600; font-size: 0.95rem; }
  .cert-meta {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--faint);
  }

  @media (max-width: 820px) {
    .index { grid-template-columns: 1fr; gap: 1.75rem; }
    /* The index becomes a wrapping row of compact buttons */
    .tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .tab,
    .tab:last-child {
      display: inline-flex;
      gap: 0.45rem;
      padding: 0.45rem 0.8rem;
      border: 1px solid var(--line);
      border-radius: var(--btn-radius);
    }
    .tab.is-active {
      padding-left: 0.8rem;
      border-color: var(--accent);
      background: var(--accent-soft);
    }
    .tab::before, .tab-count { display: none; }
    .tab-name { font-family: var(--body); font-size: 0.9rem; font-weight: 500; letter-spacing: 0; }
  }
</style>
